@article{thewissen_automation_2019,
  title = {Automation and the {{Welfare State}}: {{Technological Change}} as a {{Determinant}} of {{Redistribution Preferences}}},
  shorttitle = {Automation and the {{Welfare State}}},
  author = {Thewissen, Stefan and Rueda, David},
