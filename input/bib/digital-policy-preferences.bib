@article{busemeyer_social_2022,
  title = {Social {{Investment}}, {{Redistribution}} or {{Basic Income}}? {{Exploring}} the {{Association Between Automation Risk}} and {{Welfare State Attitudes}} in {{Europe}}},
  shorttitle = {Social {{Investment}}, {{Redistribution}} or {{Basic Income}}?},
  author = {Busemeyer, Marius R. and Sahm, Alexander H. J.},
  year = 2022,
  month = oct,
  journal = {Journal of Social Policy},
  volume = {51},
  number = {4},
  pages = {751--770},
  issn = {0047-2794, 1469-7823},
  doi = {10.1017/S0047279421000519},
  urldate = {2026-06-18},
  abstract = {Abstract Rapid technological change -- the digitalization and automation of work -- is challenging contemporary welfare states. Most of the existing research, however, focuses on its effect on labor market outcomes, such as employment or wage levels. In contrast, this paper studies the implications of technological change for welfare state attitudes and preferences. Compared to previous work on this topic, this paper adopts a much broader perspective regarding different kinds of social policy. Using data from the European Social Survey, we find that individual automation risk is positively associated with support for redistribution, but negatively with support for social investment policies (partly depending on the specific measure of automation risk that is used), while there is no statistically significant association with support for basic income. We also find a moderating effect of the overall size of the welfare state on the micro-level association between risk and preferences.},
  langid = {english},
  file = {C:\Users\kevin\Zotero\storage\JWUK42VJ\Busemeyer y Sahm - 2022 - Social Investment, Redistribution or Basic Income Exploring the Association Between Automation Risk.pdf}
}

@misc{carrasco_redistributive_2026,
  title = {Redistributive {{Justice}}, {{Job Insecurity}}, and {{Perceived Technological Risk}}: {{How Labor Market Position Shapes}} the {{Legitimacy}} of the {{Welfare State}} in 27 {{OECD Countries}}},
  shorttitle = {Redistributive {{Justice}}, {{Job Insecurity}}, and {{Perceived Technological Risk}}},
  author = {Carrasco, Kevin},
  year = 2026,
  publisher = {OSF Registries},
  doi = {10.17605/OSF.IO/BW26X},
  urldate = {2026-07-16},
  abstract = {Contemporary technological transformations---automation, artificial intelligence, algorithmic management, and intermediation through digital platforms---are altering the conditions under which workers relate to social protection systems, which were built on the premise of stable, full-time, long-term employment (Esping-Andersen, 1990; Frey \&amp; Osborne, 2017; Vallas \&amp; Schor, 2020). The growing decoupling between this model and the actual forms of work---temporary contracts, self-employment, and platform-mediated work---raises the question of how citizens today perceive the fairness of the exchange they maintain with the institutions that are meant to protect them. This study examines whether perceiving the functioning of the state as fair is related to position in the labor market and to the perception of technological risk. The central object of analysis is perceived redistributive justice, that is, the evaluative judgment of whether the benefits an individual receives from the state constitute fair compensation for the taxes and contributions they pay (Roosma, van Oorschot \&amp; Gelissen, 2016). This object is distinct from preferences for redistribution---normative beliefs about how resources should be distributed---which have dominated the attention of the literature. Its theoretical foundation is the logic of reciprocity: the legitimacy of the system rests on the perceived fairness of the exchange between contributions and benefits (Rothstein, 1998; Mau, 2003; Cavaill\'e, 2023). Using data from the OECD's Risks That Matter survey (2024), which covers more than 40,000 people across 27 countries, this research simultaneously introduces three elements that have rarely been examined together: (i) labor market position by employment type---formal employees, self-employed workers, and platform workers---forms with unequal links to social protection; (ii) the perception of technological risk, distinguishing its threatening dimension (displacement risk) from its enabling dimension (perceived benefit); and (iii) the perceived deservingness of others, as a predictor of how each individual evaluates their own relationship with the system (van Oorschot, 2000, 2006). Labor market position. The type of employment directly structures the relationship with the protection system. Formal employees contribute through registered contributions and accumulate rights in a legible way, whereas non-formal workers---the self-employed and, more acutely, platform workers classified as independent contractors---face a more opaque and unfavorable relationship, remaining largely outside the formal architecture of social insurance (Rueda, 2007; Schwander \&amp; H\"ausermann, 2013; Vallas \&amp; Schor, 2020; Guti\'errez-Crocco \&amp; Atzeni, 2022). This institutional distance makes a less favorable evaluation of the fairness of the fiscal exchange expectable. H1: Workers in non-formal employment---platform work and self-employment---will perceive lower redistributive justice than workers in formal salaried employment. Job insecurity. Beyond employment type, job insecurity---the subjective assessment of the likelihood of losing one's job or income in the short term---constitutes a distinct dimension of vulnerability that also affects formally protected workers (Sverke, Hellgren \&amp; N\"aswall, 2002; De Witte, 2005). Those who anticipate losing their job scrutinize more closely what they would receive from the state and, lacking confidence in its protective capacity, are likely to perceive the exchange as less fair (Marx, 2014). H2: Greater perceived job insecurity will be associated with lower perceived redistributive justice. Perceived risk of technological displacement. What matters for welfare attitudes is not the objective magnitude of automation, but the way workers anticipate its effects on their own job (Gallego \&amp; Kurer, 2022). The literature on risk and redistribution has established that perceived exposure to technological risk increases demand for social protection (Rehm, 2009; Thewissen \&amp; Rueda, 2019; Busemeyer \&amp; Sahm, 2022). Following this logic, those who perceive their job as threatened hold higher expectations of protection and, when comparing these to what they actually receive, are more likely to evaluate their exchange with the state as insufficient. H3: Workers who perceive a higher probability of being displaced by automation, platform competition, or the obsolescence of their skills will report lower perceived redistributive justice. Perceived technological benefit. Unlike displacement risk, perceiving technology as an improvement in working conditions---greater work-life balance, reduced physical demands, less monotony---places the worker in a position of lower risk exposure and greater optimism about their trajectory (Autor, 2015; Brougham \&amp; Haar, 2018). To the extent that the evaluation of the exchange reflects the individual's economic security (Rehm, 2009), a more favorable perception of fairness can be expected. H4: Workers who perceive technology as enabling---reducing physical demands, improving work-life balance, or making work less stressful or monotonous---will perceive higher redistributive justice. Perceived deservingness of others. Perceptions of fairness depend not only on structural position, but also on the normative frameworks through which it is judged who deserves to receive from the state (van Oorschot, 2000; Petersen, 2012). The judgment about others' deservingness is analytically distinct from the judgment about one's own relationship with the system, but both are part of the same moral economy of welfare, connected by the norm of reciprocity: when one's own contributions appear to sustain those who do not do their part, the sense of being treated fairly is eroded (Mau, 2003; Reeskens \&amp; van Oorschot, 2013; Cavaill\'e, 2023). H5: Workers who perceive that many people receive public benefits without deserving them will report lower perceived redistributive justice. Welfare regimes and institutional context. Individual perceptions are formed within institutional contexts that vary across welfare regimes (Esping-Andersen, 1990; Arts \&amp; Gelissen, 2002). In social-democratic regimes, protection is comprehensive and universal; in liberal regimes, it is residual and means-tested, organized around the market; and in conservative-corporatist regimes, rights are strongly tied to employment status (Korpi \&amp; Palme, 1998; Ferrera, 1996; Mart\'inez Franzoni, 2008). Perceived fairness can be expected to be, on average, higher where protection is more universal (Larsen, 2008). H6: On average, workers in social-democratic regimes will perceive higher redistributive justice than workers in liberal and conservative regimes. The institutional context not only shifts the average level of perceptions but can also moderate the effect of individual predictors. The institutional distance between non-formal workers and the system, the dependence of protection on employment trajectory, and the prominence of deservingness judgments are all greater in liberal and conservative regimes than in universalist ones (Ferrera, 1996; Larsen, 2008; Schwander \&amp; H\"ausermann, 2013; van Oorschot et al., 2017). Three moderation hypotheses follow from this: H7: The negative relationship between non-standard employment (platform work and self-employment) and perceived redistributive justice will be moderated by welfare regime. H8: The negative effect of perceived technological displacement risk on perceived redistributive justice will be moderated by welfare regime. H9: The negative effect of the perceived deservingness of others on perceived redistributive justice will be moderated by welfare regime.},
  archiveprefix = {OSF Registries},
  collaborator = {{Center for Open Science}},
  copyright = {Creative Commons Zero v1.0 Universal},
  keywords = {Social and Behavioral Sciences}
}

